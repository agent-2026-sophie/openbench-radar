# Optional environment variables for OpenBench Radar.
# Copy to `.env` and fill in the values you have. All are OPTIONAL —
# the agent runs with arXiv + Hugging Face using no keys at all.

# --- LLM research (OpenAI-compatible) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Web search (pick one) ---
# TAVILY_API_KEY=tvly-...
# SERPER_API_KEY=...
